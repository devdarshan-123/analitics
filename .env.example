# Copy to .env (repo root) and fill in. Never commit .env.

# --- Mode ---------------------------------------------------------------
# true = serve realistic fake data for GA4 and Clarity (no credentials needed)
MOCK_MODE=true

# --- Google Analytics 4 ---------------------------------------------------
# Every property the service account can see is discovered via the Analytics Admin API.
# Optional default property (numeric ID, NOT G-XXXX). Blank = first property in the list.
GA4_PROPERTY_ID=
# Optional: only show these properties (comma-separated numeric IDs)
GA_PROPERTY_ALLOWLIST=
# Path to the service-account JSON key. Absolute, or relative to the repo root.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga-service-account.json

# --- Microsoft Clarity ----------------------------------------------------
# Clarity -> Settings -> Data Export -> Generate new API token
# Legacy single token: linked to the default property (GA4_PROPERTY_ID)
CLARITY_API_TOKEN=
# One Clarity project per site: JSON of GA4 property ID -> token
# CLARITY_TOKENS={"560115218": "token-a", "379576149": "token-b"}
CLARITY_TOKENS=
# Needed to save tokens from Settings (stored Fernet-encrypted). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLARITY_TOKEN_ENCRYPTION_KEY=

# --- App ------------------------------------------------------------------
# SQLite for local dev. Postgres example: postgresql://user:pass@host:5432/analytics
DATABASE_URL=sqlite:///./analytics.db
# Password for the dashboard login page
DASHBOARD_PASSWORD=change-me
# Optional: secret used to sign session cookies (defaults to one derived from the password)
SESSION_SECRET=
# Set true when serving over HTTPS
COOKIE_SECURE=false
TZ=Asia/Kolkata
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Scheduler --------------------------------------------------------------
ENABLE_SCHEDULER=true
CLARITY_SYNC_HOUR=2
CLARITY_SYNC_MINUTE=0

LOG_LEVEL=INFO
